{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aysu-rezervasyon",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // Statik sayfalar (site ve rezervasyon sayfası)
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // Veritabanı: rezervasyonlar, aboneler, müşteri notları; işlemleri sıraya sokar
  "durable_objects": {
    "bindings": [{ "name": "REZERVASYON_DEPOSU", "class_name": "RezervasyonDeposu" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RezervasyonDeposu"] }],

  // IP başına dakikada en fazla 20 istek
  "ratelimits": [
    { "name": "SINIR", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],

  "observability": { "enabled": true },

  // Panelden girilen değişkenler yeni yüklemelerde silinmesin
  "keep_vars": true,

  // Yönetim paneli (/panel) ilk kurulum ve şifre sıfırlama kodu. Gizli tutun.
  "vars": { "PANEL_KURULUM_KODU": "BVY3oMi4BoyVVkGS" }

  // İsteğe bağlı gizli değerler (Cloudflare paneli → Settings → Variables and Secrets → Secret):
  //   RESEND_API_KEY, BILDIRIM_EPOSTA         (e-posta bildirimi)
  //   TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID   (Telegram bildirimi)
}
